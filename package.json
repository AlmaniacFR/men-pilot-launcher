{
  "name": "men-pilot-launcher",
  "version": "2.0.0",
  "description": "Local control center and developer launcher for MEN Pilot",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --config electron-builder.config.cjs --win nsis --publish never",
    "publish": "electron-builder --config electron-builder.config.cjs --win nsis --publish always",
    "pack": "electron-builder --config electron-builder.config.cjs --dir"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "systeminformation": "^5.33.1"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
